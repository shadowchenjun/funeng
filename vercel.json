{
  "buildCommand": "cd backend && pip install --break-system-packages -r requirements.txt",
  "installCommand": "cd backend && pip install --break-system-packages -r requirements.txt",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
