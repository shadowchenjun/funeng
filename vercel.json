{
  "buildCommand": "cd frontend && npm run build && cp -r dist ../dist",
  "installCommand": "cd frontend && npm install",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/main.py"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/dist/index.html"
    }
  ]
}
